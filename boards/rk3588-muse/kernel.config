# MUSE RK3588 (rk3588-muse) 专用内核配置 fragment
#
# 由 scripts/build_kernel.sh 在 rootfs-base.config 与 squashfs-overlay.config
# 之后合并，因此可以覆盖共享配置。本文件只放板级专属项，通用项不要放这里。
#
# 本文件即 build_kernel.sh 自动合并的板级 fragment（boards/<BOARD>/kernel.config），
# 在共享 fragment (rootfs-base.config + squashfs-overlay.config) 之后合并，可覆盖共享配置。

# 给内核版本加板级后缀，便于区分不同板型的产物
CONFIG_LOCALVERSION="-muse"

# =============================================================================
# WiFi/BT: FCU761K-L (Quectel, AIC8800DC chip, USB 2.0 via CH334H hub)
# =============================================================================
# 无线子系统核心（defconfig 中缺失）
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# AIC8800 驱动（board.hooks.sh 的 pre_build_kernel hook 自动将源码集成到
# drivers/net/wireless/aic8800/ 和 drivers/bluetooth/aic_btusb/，并应用补丁）
CONFIG_AIC_WLAN_SUPPORT=m
# 注：CONFIG_PLATFORM_UBUNTU 是驱动 Makefile 内部变量（?= y 自动生效），
# 非内核 Kconfig 选项，不需要在此设置。

# =============================================================================
# RTC: DS1307 外部实时时钟（I2C2 总线，0x68）
# =============================================================================
# defconfig 中缺失；DTS 中 &i2c2 启用了 ds1307@68 节点
CONFIG_RTC_DRV_DS1307=y

# =============================================================================
# Watchdog: SGM820B 外部硬件看门狗（GPIO 脉冲喂狗）
# =============================================================================
# defconfig 中缺失；DTS 中 gpio-wdt 节点引用 GPIO4_A4
CONFIG_GPIO_WATCHDOG=y

# =============================================================================
# USB Ethernet: SR9900AI USB 2.0 → 10/100（usb_host0 端口）
# =============================================================================
# defconfig 中缺失 USB 网络框架及芯片驱动
# SR9900AI 兼容 DM9601 和 SR9800 驱动，同时启用以确保 USB ID 匹配
CONFIG_USB_USBNET=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SR9800=y

# =============================================================================
# BT SCO: 蓝牙语音 PCM 接口（可选，仅 HFP/免提需要；A2DP 不需要）
# =============================================================================
CONFIG_SND_SOC_BT_SCO=y

# =============================================================================
# BT BNEP: 蓝牙 PAN 网络封装协议（Bluetooth tethering / 个人局域网）
# =============================================================================
CONFIG_BT_BNEP=y

# =============================================================================
# 禁用无关媒体模块（USB 电视棒 / DVB / 模拟调谐器）
# =============================================================================
# defconfig 开了 MEDIA_SUPPORT=y + MEDIA_USB_SUPPORT=y（为了摄像头/ISP/HDMI输入），
# 连带拉入 ~185 个 DVB/tuner 模块，MUSE 板不需要。
# 关闭数字电视和模拟电视支持，保留摄像头和平台媒体。
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
